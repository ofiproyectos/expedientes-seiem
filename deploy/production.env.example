APP_NAME=Expedientes
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://expedientes.example.org
APP_LOCALE=es
DB_CONNECTION=mysql
DB_HOST=expedientes-db
DB_PORT=3306
DB_DATABASE=expedientes
DB_USERNAME=expedientes
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_COOKIE=expedientes_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
DOCUMENTS_PATH=/var/www/expedientes/storage/app/private
OIDC_ENABLED=true
OIDC_ISSUER=https://identity.example.org/realms/seiem
OIDC_CLIENT_ID=expedientes-seiem
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://expedientes.example.org/auth/callback
OIDC_CA_BUNDLE=
OIDC_BOOTSTRAP_ADMIN_SUB=
PLATFORM_URL=https://portal.example.org
PLATFORM_ACCESS_URL=https://portal.example.org/api/integraciones/expedientes/acceso
PLATFORM_ACCESS_TOKEN=
